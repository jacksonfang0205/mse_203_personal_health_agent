# Copy to .env.local. Never commit real keys. All keys are server-side only.
# Phase 1 needs none of these.

# Phase 2: agent reasoning (server-side only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Week 3 (optional): Google Calendar FreeBusy, read-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
