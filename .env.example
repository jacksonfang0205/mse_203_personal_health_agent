# Copy to .env.local. Never commit real keys. All keys are server-side only.
# Without a key the app still runs, using the rule-based planner.

# Agent reasoning (server-side only; never prefix with NEXT_PUBLIC_).
# Same settings as the time-assistant prototype. "openai" = any OpenAI-compatible
# gateway such as the Stanford AI API Gateway; "anthropic" = Claude API direct.
LLM_PROVIDER=openai
LLM_BASE_URL=https://aiapi-prod.stanford.edu/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
# Or, for the Claude API: leave LLM_* empty and set
ANTHROPIC_API_KEY=

# Optional: accounts. Google sign-in, read-only Google Calendar import, and
# saving each user's data to Neon Postgres. Leave empty to keep everything in
# the browser only; the sign-in button stays hidden until all four are set.
#   DATABASE_URL       Neon connection string (Neon console > Connect)
#   AUTH_SECRET        any long random string, e.g. `npx auth secret`
#   AUTH_GOOGLE_ID     Google Cloud OAuth client (Web application)
#   AUTH_GOOGLE_SECRET its secret
# Google OAuth client: add redirect URI http://localhost:3000/api/auth/callback/google
# (and https://<your-domain>/api/auth/callback/google), enable the Google Calendar API,
# and add the calendar.readonly scope on the consent screen.
# Then create the tables once: npm run db:push
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
