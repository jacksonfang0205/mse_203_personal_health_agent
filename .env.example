# Copy to .env.local. Never commit real keys. All keys are server-side only.
# Without a key the app still runs, using the rule-based planner.

# Agent reasoning (server-side only; never prefix with NEXT_PUBLIC_).
# Same settings as the time-assistant prototype. "openai" = any OpenAI-compatible
# gateway such as the Stanford AI API Gateway; "anthropic" = Claude API direct.
LLM_PROVIDER=openai
LLM_BASE_URL=https://aiapi-prod.stanford.edu/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
# Or, for the Claude API: leave LLM_* empty and set
ANTHROPIC_API_KEY=

# Week 3 (optional): Google Calendar FreeBusy, read-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
